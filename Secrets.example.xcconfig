// Copy this file to Secrets.xcconfig and fill in your two keys.
// Secrets.xcconfig is gitignored — never commit real keys.
//
//   cp Secrets.example.xcconfig Secrets.xcconfig

// ── Keys: fill these in ──────────────────────────────────────────────

// Aisha — speech to text for voice notes.
// Get a key at https://space.aisha.group → API kalitlari
// Without it the microphone button is disabled and you type instead.
AISHA_API_KEY = 

// OpenAI — chooses which of your categories an expense belongs to.
// Get a key at https://platform.openai.com/api-keys
// Without it no category is suggested and you pick one yourself.
OPENAI_API_KEY = 

// ── Model: these values are the tested defaults ──────────────────────

// gpt-5-nano scored 20/20 on the Uzbek notes in tools/compare-models.py
// at $0.03 per 1000 expenses. gpt-5-mini also scores 20/20 but costs 4x
// more; gpt-4o-mini scores 18/20.
OPENAI_MODEL = gpt-5-nano

// minimal | low | medium | high — gpt-5* models only.
// This matters MORE than the model choice. Leaving it unset lets the
// model reason without limit, which took 39.6s and cost 5x as much for
// a worse score. Measured on the same 20 notes with gpt-5-nano:
//   (unset)  19/20  39.6s  $0.14 per 1000 expenses
//   low      20/20   7.8s  $0.03   ← this
//   minimal  14/20   3.5s  $0.01
OPENAI_REASONING_EFFORT = low
