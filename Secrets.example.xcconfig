// Copy this file to Secrets.xcconfig and fill in your keys.
// Secrets.xcconfig is gitignored — never commit real keys.
//
//   cp Secrets.example.xcconfig Secrets.xcconfig
//
// Aisha — speech to text for voice notes.
// Get a key at https://space.aisha.group → API kalitlari
// Without it the microphone button is disabled and you type instead.
AISHA_API_KEY = 

// OpenAI — chooses which of your categories an expense belongs to.
// Get a key at https://platform.openai.com/api-keys
// Without it no category is suggested and you pick one yourself.
OPENAI_API_KEY = 

// Optional. Defaults to gpt-4o-mini. A larger model reads Uzbek better.
OPENAI_MODEL = 
