// Copy this file to Secrets.xcconfig and fill in your keys.
// Secrets.xcconfig is gitignored — never commit real keys.
//
//   cp Secrets.example.xcconfig Secrets.xcconfig

// Aisha — speech to text for voice notes.
// Get a key at https://space.aisha.group → API kalitlari
// Without it the microphone button is disabled and you type instead.
AISHA_API_KEY = 

// OpenAI — chooses which of your categories an expense belongs to.
// Get a key at https://platform.openai.com/api-keys
// Without it no category is suggested and you pick one yourself.
OPENAI_API_KEY = 

// Optional. Defaults to gpt-5-nano.
OPENAI_MODEL = 

// Optional. minimal | low | medium | high. Defaults to low, and applies
// only to gpt-5* models — they reason before answering, and uncapped that
// is slow and expensive for a one-line classification.
//
// Measured on the 20 Uzbek notes in tools/compare-models.py, gpt-5-nano:
//   (unset)  19/20  39.6s  $0.14 per 1000 expenses
//   low      20/20   7.8s  $0.03
//   minimal  14/20   3.5s  $0.01
// Re-measure any change with tools/compare-models.py.
OPENAI_REASONING_EFFORT = 
